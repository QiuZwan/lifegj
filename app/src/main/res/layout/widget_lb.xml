<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件（4×2）的版式。
  只用 RemoteViews 支持的那几种控件与属性：LinearLayout / TextView 与 android:padding 这类，
  像 background 用 shape drawable、圆角、选择器都没问题；但不能用 Compose、不能用自定义 View。
  行数刻意保留余量（body 允许 3 行），因为系统字体放大到「大」时，同一句话会占更多行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lb_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_lb_bg"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:id="@+id/lb_widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#7C837A"
        android:textSize="11sp"
        android:text="@string/lb_widget_name" />

    <TextView
        android:id="@+id/lb_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#EFEDE6"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lb_widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="#AEB5AC"
        android:textSize="12sp" />

    <!--
      「记一笔」的独立小入口。
      原来把「正文区域」直接映射成「去记账本」很反直觉 —— 点正文通常想要"看详情"。
      现在正文与整块一致进对应页，记账单独给这一行。
    -->
    <TextView
        android:id="@+id/lb_widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_lb_action_bg"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:text="@string/lb_widget_action"
        android:textColor="#EFEDE6"
        android:textSize="11sp" />

</LinearLayout>
