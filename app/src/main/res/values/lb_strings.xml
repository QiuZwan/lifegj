<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件与长按快捷方式用到的文字，统一放这里。
  单独开一个文件而不是塞进 themes.xml：字符串资源和主题混在一起，改主题的人容易误删。
  （widget / shortcut 的 label 必须是字符串资源，XML 里不认字面量，所以必须有这一个文件。）
-->
<resources>
