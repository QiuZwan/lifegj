<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 一键扫描:读取扣费短信(仅本机分析,不上传任何内容) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- 每日简报通知(Android 13+ 需运行时授权)与开机后恢复闹钟 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 桌面天气(可选):仅用于下载所在城市天气,不上传任何数据;关闭后完全不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        「检查更新 → 更新」要在应用内直接下载并调起安装界面,这条路需要它。
        注意:声明了它**不等于**就能装 —— Android 8.0 起每台设备还要用户在
        「安装未知应用」里对这个 App 单独允许一次(由 UpdateDownload.canInstall 检查并引导)。
        最后那个「安装」按钮也必须用户自己点,系统不允许程序代点。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="生活管家"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeButler">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 长按图标弹出的「记一笔 / 问管家」两个快捷方式（见 res/xml/lb_shortcuts.xml） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/lb_shortcuts" />
        </activity>
        <!-- 桌面小组件：显示「今天有什么要留意」，点击直达对应页面 -->
        <receiver
            android:name=".widget.LbWidgetProvider"
            android:exported="false"
            android:label="@string/lb_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lb_widget_info" />
        </receiver>
        <service
            android:name=".data.NotifListenerService"
            android:exported="true"
            android:label="生活管家 · 扣费通知读取"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".data.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 备忘录里自己设定的提醒时间:由本机闹钟在到点那一刻唤起 -->
        <receiver
            android:name=".data.MemoReceiver"
            android:exported="false" />
        <!-- 打开档案库里已保存的本机文件(仅把 App 私有目录里的文件以只读方式临时授权给查看器) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- 需检测的常见订阅类应用(用于「一键扫描」的已安装应用检查,避免申请全量应用权限) -->
    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.qiyi.video" />
        <package android:name="com.tencent.qqlive" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.gotokeep.keep" />
        <package android:name="com.jingdong.app.mall" />
        <package android:name="com.sankuai.meituan" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.youku.phone" />
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.unionpay" />
    </queries>

</manifest>
